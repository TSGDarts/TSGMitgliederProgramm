# =====================================================================
# Umgebungsvariablen für die TSG-Dart-Website
# ---------------------------------------------------------------------
# 1. Diese Datei nach ".env.local" kopieren.
# 2. Werte aus dem Supabase-Dashboard eintragen
#    (Project Settings -> API).
# 3. Bei Vercel dieselben Variablen unter
#    Settings -> Environment Variables hinterlegen.
# =====================================================================

# Öffentliche Adresse deines Supabase-Projekts (Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Öffentlicher "anon"-Schlüssel (darf im Browser landen)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geheimer "service_role"-Schlüssel – NUR serverseitig!
# Wird gebraucht, damit der Admin neue Zugänge anlegen kann.
# NIEMALS in den Browser/öffentlich geben.
SUPABASE_SERVICE_ROLE_KEY=

# Schützt den täglichen nuLiga-Abgleich (mindestens 16 zufällige Zeichen).
# Vercel sendet diesen Wert automatisch als Authorization: Bearer … mit.
CRON_SECRET=

# Basis-Adresse der Website (für Einladungs-/Passwortlinks)
# Lokal:   http://localhost:3000
# Live:    https://deine-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
